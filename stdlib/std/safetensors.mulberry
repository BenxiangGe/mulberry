package std.safetensors;

import list;
import list.List;
import core;
import io;
import io.File;
import json;
import json.Cursor;
import result.Result;
import result.Ok;
import result.Err;
import string;
import string.String;
import tensor;
import tensor.Tensor;

data SafetensorsError =
    IoFailure(io.FileError)
  | JsonFailure(json.JsonError)
  | TensorNotFound(String)
  | InvalidTensor(String)
  | InvalidFile(String)
  | EmptyTensorName()
  | DuplicateTensorName(String)
  | ReservedTensorName(String);

impl Show for SafetensorsError {
  fn toString(self: SafetensorsError): String {
    return match self {
      IoFailure(fileError) => fileError.toString(),
      JsonFailure(jsonError) => jsonError.toString(),
      TensorNotFound(name) => string.format("tensor {} was not found", name),
      InvalidTensor(name) =>
          string.format("tensor {} has invalid metadata", name),
      InvalidFile(reason) =>
          string.format("invalid safetensors file: {}", reason),
      EmptyTensorName() => "tensor name must not be empty",
      DuplicateTensorName(name) =>
          string.format("duplicate tensor name {}", name),
      ReservedTensorName(name) =>
          string.format("reserved tensor name {}", name),
    };
  }
}

fn mapIoError<T>(result: Result<T, io.FileError>):
    Result<T, SafetensorsError> {
  match result {
    Ok(value) => return Ok(value);
    Err(error) => return Err(IoFailure(error));
  }
}

fn mapJsonError<T>(result: Result<T, json.JsonError>):
    Result<T, SafetensorsError> {
  match result {
    Ok(value) => return Ok(value);
    Err(error) => return Err(JsonFailure(error));
  }
}

fn maxUInt64(): UInt64 {
  return 18446744073709551615;
}

fn addChecked(left: UInt64, right: UInt64): Result<UInt64, SafetensorsError> {
  if left > maxUInt64() - right {
    return Err(InvalidFile("UInt64 addition overflow"));
  }
  return Ok(left + right);
}

fn mulChecked(left: UInt64, right: UInt64): Result<UInt64, SafetensorsError> {
  if right != 0 and left > maxUInt64() / right {
    return Err(InvalidFile("UInt64 multiplication overflow"));
  }
  return Ok(left * right);
}

fn stringsEqual(left: String, right: String): Bool {
  if left.length != right.length {
    return false;
  }
  var index = 0;
  while index < left.length {
    if left.data[index] != right.data[index] {
      return false;
    }
    index = index + 1;
  }
  return true;
}

struct TensorInfo {
  headerLength: UInt64,
  begin: UInt64,
  end: UInt64,
  shape: List<UInt64>
}

struct TensorMetadata {
  info: TensorInfo,
  hasDtype: Bool,
  hasShape: Bool,
  hasOffsets: Bool
}

struct TensorFile {
  file: File,
  headerLength: UInt64,
  headerBytes: Tensor<UInt8>,
  fileSize: UInt64
}

struct NamedTensor {
  name: String,
  value: Tensor<Float32>
}

struct ByteBuffer {
  bytes: List<UInt8>,

  pub fn pushChar(mut self: ByteBuffer, value: UInt8): () {
    self.bytes.push(value);
  }

  pub fn pushString(mut self: ByteBuffer, value: String): () {
    var index = 0;
    while index < value.length {
      self.bytes.push(value.data[index]);
      index = index + 1;
    }
  }

  pub fn pushUInt64(mut self: ByteBuffer, value: UInt64): () {
    if value == 0 {
      self.pushChar('0');
    } else {
      var digits: List<UInt8> = list.withCapacity(0);
      var remaining = value;
      while remaining > 0 {
        const digitValue = remaining % 10 + core.toUInt64('0');
        const digit = core.toUInt8(digitValue);
        digits.push(digit);
        remaining = remaining / 10;
      }

      var index = digits.size();
      while index > 0 {
        index = index - 1;
        self.pushChar(digits[index]);
      }
    }
  }

  pub fn pushShape(mut self: ByteBuffer, shape: List<UInt64>): () {
    var index = 0;
    while index < shape.size() {
      if index > 0 {
        self.pushChar(',');
      }
      self.pushUInt64(shape[index]);
      index = index + 1;
    }
  }

  pub fn pushTensorHeader(mut self: ByteBuffer, name: String,
                          value: Tensor<Float32>,
                          offset: UInt64): Result<UInt64, SafetensorsError> {
    const byteSize = mulChecked(value.numel, #sizeof(Float32))?;
    const nextOffset = addChecked(offset, byteSize)?;
    json.appendQuotedString(self.bytes, name);
    self.pushString(
        ":{\"dtype\":\"F32\",\"shape\":[");
    self.pushShape(value.sizes);
    self.pushString("],\"data_offsets\":[");
    self.pushUInt64(offset);
    self.pushChar(',');
    self.pushUInt64(nextOffset);
    self.pushString("]}");
    return Ok(nextOffset);
  }
}

fn validateEntries(entries: List<NamedTensor>): Result<(), SafetensorsError> {
  var index = 0;
  while index < entries.size() {
    const name = entries[index].name;
    if name.length == 0 {
      return Err(EmptyTensorName());
    }
    if stringsEqual(name, "__metadata__") {
      return Err(ReservedTensorName(name));
    }

    var previous = 0;
    while previous < index {
      if stringsEqual(name, entries[previous].name) {
        return Err(DuplicateTensorName(name));
      }
      previous = previous + 1;
    }
    index = index + 1;
  }
  return Ok(());
}

fn parseTensorField(mut parser: Cursor, mut metadata: TensorMetadata,
                    name: String): Result<(), SafetensorsError> {
  const keyStart = parser.position;
  if mapJsonError(parser.stringEquals("dtype"))? {
    mapJsonError(parser.expectChar(':'))?;
    if mapJsonError(parser.stringEquals("F32"))? {
      metadata.hasDtype = true;
      return Ok(());
    }
    return Err(InvalidTensor(name));
  }

  parser.position = keyStart;
  if mapJsonError(parser.stringEquals("shape"))? {
    mapJsonError(parser.expectChar(':'))?;
    metadata.info.shape = mapJsonError(parser.parseIntegerArray())?;
    metadata.hasShape = true;
    return Ok(());
  }

  parser.position = keyStart;
  if mapJsonError(parser.stringEquals("data_offsets"))? {
    mapJsonError(parser.expectChar(':'))?;
    const offsets = mapJsonError(parser.parseIntegerArray())?;
    if offsets.size() != 2 {
      return Err(InvalidTensor(name));
    }
    metadata.info.begin = offsets[0];
    metadata.info.end = offsets[1];
    if metadata.info.end < metadata.info.begin {
      return Err(InvalidTensor(name));
    }
    metadata.hasOffsets = true;
    return Ok(());
  }

  parser.position = keyStart;
  mapJsonError(parser.skipString())?;
  mapJsonError(parser.expectChar(':'))?;
  mapJsonError(parser.skipValue())?;
  return Ok(());
}

fn parseTensorObject(mut parser: Cursor, headerLength: UInt64,
                     name: String): Result<TensorInfo, SafetensorsError> {
  var metadata = TensorMetadata {
    TensorInfo { headerLength, 0, 0, list.withCapacity(0) },
    false,
    false,
    false
  };

  mapJsonError(parser.expectChar('{'))?;
  while true {
    if parser.consumeIfChar('}') {
      break;
    }

    match parseTensorField(parser, metadata, name) {
      Ok(unit) => unit;
      Err(error) => return Err(error);
    }

    var reachedEnd = false;
    match mapJsonError(parser.consumeSeparatorOrEnd('}')) {
      Ok(value) => reachedEnd = value;
      Err(error) => return Err(error);
    }
    if reachedEnd {
      break;
    }
  }

  if metadata.hasDtype and metadata.hasShape and metadata.hasOffsets {
    return Ok(metadata.info);
  }
  return Err(InvalidTensor(name));
}

fn prepareTensorEntry(mut parser: Cursor, name: String):
    Result<Bool, SafetensorsError> {
  const keyStart = parser.position;
  if mapJsonError(parser.stringEquals(name))? {
    mapJsonError(parser.expectChar(':'))?;
    return Ok(true);
  }

  parser.position = keyStart;
  mapJsonError(parser.skipString())?;
  mapJsonError(parser.expectChar(':'))?;
  mapJsonError(parser.skipValue())?;
  return Ok(false);
}

fn findTensorInHeader(mut parser: Cursor, name: String,
                      headerLength: UInt64):
    Result<TensorInfo, SafetensorsError> {
  mapJsonError(parser.expectChar('{'))?;
  if parser.consumeIfChar('}') {
    return Err(TensorNotFound(name));
  }

  while true {
    var found = false;
    match prepareTensorEntry(parser, name) {
      Ok(value) => found = value;
      Err(error) => return Err(error);
    }
    if found {
      return parseTensorObject(parser, headerLength, name);
    }

    var reachedEnd = false;
    match mapJsonError(parser.consumeSeparatorOrEnd('}')) {
      Ok(value) => reachedEnd = value;
      Err(error) => return Err(error);
    }
    if reachedEnd {
      break;
    }
  }
  return Err(TensorNotFound(name));
}

fn readHeaderLength(file: File): Result<UInt64, SafetensorsError> {
  var tensorBytes: Tensor<UInt8> = tensor.zeros([8]);
  mapIoError(io.seek(file, 0))?;
  mapIoError(io.readExact(file, tensorBytes))?;
  return Ok(core.toUInt64(tensorBytes[0]) +
      core.toUInt64(tensorBytes[1]) * 256 +
      core.toUInt64(tensorBytes[2]) * 65536 +
      core.toUInt64(tensorBytes[3]) * 16777216 +
      core.toUInt64(tensorBytes[4]) * 4294967296 +
      core.toUInt64(tensorBytes[5]) * 1099511627776 +
      core.toUInt64(tensorBytes[6]) * 281474976710656 +
      core.toUInt64(tensorBytes[7]) * 72057594037927936);
}

fn loadTensorFile(file: File): Result<TensorFile, SafetensorsError> {
  const fileSize = mapIoError(io.fileSize(file))?;
  if fileSize < 8 {
    return Err(InvalidFile("file is shorter than the header length field"));
  }
  const headerLength = readHeaderLength(file)?;
  if headerLength > 100000000 {
    return Err(InvalidFile("header exceeds 100000000 bytes"));
  }
  if headerLength > fileSize - 8 {
    return Err(InvalidFile("header extends past end of file"));
  }
  var headerBytes: Tensor<UInt8> = tensor.zeros([headerLength]);
  mapIoError(io.seek(file, 8))?;
  mapIoError(io.readExact(file, headerBytes))?;
  return Ok(TensorFile { file, headerLength, headerBytes, fileSize });
}

fn open(path: String): Result<TensorFile, SafetensorsError> {
  const file = mapIoError(io.open(path, "rb"))?;
  match loadTensorFile(file) {
    Ok(tensorFile) => return Ok(tensorFile);
    Err(error) => {
      io.close(file);
      return Err(error);
    }
  }
}

fn close(tensorFile: TensorFile): Result<(), SafetensorsError> {
  return mapIoError(io.close(tensorFile.file));
}

fn find(tensorFile: TensorFile, name: String):
    Result<TensorInfo, SafetensorsError> {
  var parser = Cursor { tensorFile.headerBytes, 0 };
  return findTensorInHeader(parser, name, tensorFile.headerLength);
}

fn read(tensorFile: TensorFile, name: String):
    Result<Tensor<Float32>, SafetensorsError> {
  const info = find(tensorFile, name)?;
  var numel: UInt64 = 1;
  for index in 0 .. info.shape.size() {
    match mulChecked(numel, info.shape[index]) {
      Ok(value) => numel = value;
      Err(error) => return Err(error);
    }
  }
  const expectedBytes = mulChecked(numel, #sizeof(Float32))?;
  if info.end < info.begin or expectedBytes != info.end - info.begin {
    return Err(InvalidTensor(name));
  }
  const dataStart = addChecked(8, info.headerLength)?;
  const fileOffset = addChecked(dataStart, info.begin)?;
  const dataEnd = addChecked(dataStart, info.end)?;
  if dataEnd > tensorFile.fileSize {
    return Err(InvalidFile("tensor data extends past end of file"));
  }
  var value: Tensor<Float32> = tensor.zerosDynamic(info.shape);
  mapIoError(io.seek(tensorFile.file, fileOffset))?;
  mapIoError(io.readExact(tensorFile.file, value))?;
  return Ok(value);
}

fn makeByteBuffer(): ByteBuffer {
  return ByteBuffer { list.withCapacity(0) };
}

fn writeUInt64LE(file: File, value: UInt64):
    Result<UInt64, SafetensorsError> {
  var bytes: Tensor<UInt8> = tensor.zeros([8]);
  var remaining = value;
  var index = 0;
  while index < 8 {
    const byteValue = remaining % 256;
    bytes[index] = core.toUInt8(byteValue);
    remaining = remaining / 256;
    index = index + 1;
  }
  return mapIoError(io.write(file, bytes));
}

fn writeHeader(file: File, header: ByteBuffer):
    Result<UInt64, SafetensorsError> {
  if header.bytes.size() > 100000000 {
    return Err(InvalidFile("header exceeds 100000000 bytes"));
  }
  const lengthBytes = writeUInt64LE(file, header.bytes.size())?;
  const headerBytes = mapIoError(io.writeBytes(file, header.bytes))?;
  return addChecked(lengthBytes, headerBytes);
}

fn writeContents(file: File, header: ByteBuffer,
                 entries: List<NamedTensor>):
    Result<UInt64, SafetensorsError> {
  var byteCount = writeHeader(file, header)?;
  for index in 0 .. entries.size() {
    match mapIoError(io.write(file, entries[index].value)) {
      Ok(written) => {
        match addChecked(byteCount, written) {
          Ok(value) => byteCount = value;
          Err(error) => return Err(error);
        }
      }
      Err(error) => return Err(error);
    }
  }
  return Ok(byteCount);
}

fn write(path: String, entries: List<NamedTensor>):
    Result<UInt64, SafetensorsError> {
  validateEntries(entries)?;
  var header = makeByteBuffer();
  header.pushChar('{');

  var offset: UInt64 = 0;
  var index = 0;
  while index < entries.size() {
    if index > 0 {
      header.pushChar(',');
    }
    match header.pushTensorHeader(entries[index].name, entries[index].value,
                                  offset) {
      Ok(value) => offset = value;
      Err(error) => return Err(error);
    }
    index = index + 1;
  }

  header.pushChar('}');

  const file = mapIoError(io.open(path, "wb"))?;
  match writeContents(file, header, entries) {
    Ok(byteCount) => {
      mapIoError(io.close(file))?;
      return Ok(byteCount);
    }
    Err(error) => {
      io.close(file);
      return Err(error);
    }
  }
}
