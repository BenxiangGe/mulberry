package std.string;

import core;
import internal.ptr;

struct String {
  length: UInt64,
  data: Ptr<UInt8>,

  pub fn slice(self: String, begin: UInt64, end: UInt64): String {
    const length = end - begin;
    var data = heap.alloc<UInt8>(length + 1);
    var index = 0;
    while index < length {
      data[index] = self.data[begin + index];
      index = index + 1;
    }
    data[length] = core.toUInt8(0);
    return String { length, data };
  }
}

extern fn mulberry_string_from_bool(value: Bool): String;
extern fn mulberry_string_from_u8(value: UInt8): String;
extern fn mulberry_string_from_u64(value: UInt64): String;
extern fn mulberry_string_from_i64(value: Int64): String;
extern fn mulberry_string_from_f32(value: Float32): String;
extern fn mulberry_string_from_f64(value: Float64): String;
extern fn mulberry_bigint_to_string(value: Integer): String;
extern fn mulberry_string_object_identity(typeName: String,
                                          object: Ptr<UInt8>): String;

fn fromBool(value: Bool): String {
  return mulberry_string_from_bool(value);
}

fn fromUInt8(value: UInt8): String {
  return mulberry_string_from_u8(value);
}

fn fromUInt64(value: UInt64): String {
  return mulberry_string_from_u64(value);
}

fn fromInt64(value: Int64): String {
  return mulberry_string_from_i64(value);
}

fn fromFloat32(value: Float32): String {
  return mulberry_string_from_f32(value);
}

fn fromFloat64(value: Float64): String {
  return mulberry_string_from_f64(value);
}

fn fromInteger(value: Integer): String {
  return mulberry_bigint_to_string(value);
}

trait Show {
  fn toString(self): String;
}

impl Show for String {
  fn toString(self: String): String {
    return self;
  }
}

impl Show for Bool {
  fn toString(self: Bool): String {
    return fromBool(self);
  }
}

impl Show for UInt8 {
  fn toString(self: UInt8): String {
    return fromUInt8(self);
  }
}

impl Show for UInt64 {
  fn toString(self: UInt64): String {
    return fromUInt64(self);
  }
}

impl Show for Int64 {
  fn toString(self: Int64): String {
    return fromInt64(self);
  }
}

impl Show for Float32 {
  fn toString(self: Float32): String {
    return fromFloat32(self);
  }
}

impl Show for Float64 {
  fn toString(self: Float64): String {
    return fromFloat64(self);
  }
}

impl Show for Integer {
  fn toString(self: Integer): String {
    return fromInteger(self);
  }
}

impl<T> Show for T where comptime { #typeInfo(T).isObject() } {
  fn toString(self: T): String {
    const info = #typeInfo(T);
    if info.isArray() {
      const displayLimit = 16;
      var result: String = "[";
      var index = 0;
      const length = info.arrayLength();
      while index < length and index < displayLimit {
        if index != 0 {
          result = result + ", ";
        }
        result = result + format("{}", self[index]);
        index = index + 1;
      }
      if length > displayLimit {
        result = result + ", ...";
      }
      return result + "]";
    }
    return objectToString(self);
  }
}

fn objectToString<T>(value: T): String {
  return __objectIdentity(value);
}

fn format<Args...: Show>(comptime pattern: String, args: Args...): String {
  var cursor = 0;
  var argumentIndex = 0;
  var result: String = "";

  while cursor < pattern.length {
    const current = pattern[cursor];
    if current == '{' {
      if cursor + 1 >= pattern.length {
        #compileError("unmatched '{' in format string");
      }

      const next = pattern[cursor + 1];
      if next == '{' {
        result = result + "{";
        cursor = cursor + 2;
      } else {
        if next != '}' {
          #compileError("expected '}' after '{' in format string");
        }
        if argumentIndex >= args.length {
          #compileError("not enough arguments for format string");
        }

        result = result + args[argumentIndex].toString();
        argumentIndex = argumentIndex + 1;
        cursor = cursor + 2;
      }
    } else {
      if current == '}' {
        if cursor + 1 < pattern.length and pattern[cursor + 1] == '}' {
          result = result + "}";
          cursor = cursor + 2;
        } else {
          #compileError("unmatched '}' in format string");
        }
      } else {
        result = result + pattern.slice(cursor, cursor + 1);
        cursor = cursor + 1;
      }
    }
  }

  if argumentIndex != args.length {
    #compileError("too many arguments for format string");
  }
  return result;
}

fn concat(left: String, right: String): String {
  const length = left.length + right.length;
  var data = heap.alloc<UInt8>(length + 1);

  var index = 0;
  while index < left.length {
    data[index] = left.data[index];
    index = index + 1;
  }

  index = 0;
  while index < right.length {
    data[left.length + index] = right.data[index];
    index = index + 1;
  }

  const nul = core.toUInt8(0);
  data[length] = nul;
  return String { length, data };
}
