package std.io;

import list.List;
import internal.ptr;
import result.Result;
import result.Ok;
import result.Err;
import string;
import string.String;
import tensor.Tensor;

struct File {
  handle: Ptr<UInt8>
}

data FileError =
    OpenFailed(String, String)
  | ReadFailed(UInt64, UInt64)
  | UnexpectedEnd(UInt64, UInt64)
  | WriteFailed(UInt64, UInt64)
  | SeekFailed(UInt64)
  | TellFailed
  | SizeFailed
  | CloseFailed
  | AlreadyClosed
  | UseAfterClose;

// RawBytes uses the current process's native layout, endianness, and ABI.
// Portable file formats must use an explicit encoding instead.
trait RawBytes {}

impl RawBytes for Bool {}
impl RawBytes for UInt8 {}
impl RawBytes for UInt64 {}
impl RawBytes for Int64 {}
impl RawBytes for Float32 {}
impl RawBytes for Float64 {}

impl Show for FileError {
  fn toString(self: FileError): String {
    return match self {
      OpenFailed(path, mode) =>
          string.format("cannot open {} with mode {}", path, mode),
      ReadFailed(expected, actual) =>
          string.format("read failed after {} of {} bytes", actual, expected),
      UnexpectedEnd(expected, actual) =>
          string.format("unexpected end of file after {} of {} bytes", actual,
                        expected),
      WriteFailed(expected, actual) =>
          string.format("write failed after {} of {} bytes", actual, expected),
      SeekFailed(offset) => string.format("cannot seek to byte {}", offset),
      TellFailed() => "cannot get file position",
      SizeFailed() => "cannot get file size",
      CloseFailed() => "cannot close file",
      AlreadyClosed() => "file is already closed",
      UseAfterClose() => "file is closed",
    };
  }
}

extern fn mulberry_file_open(path: String, mode: String): Ptr<UInt8>;
extern fn mulberry_file_is_valid(handle: Ptr<UInt8>): Bool;
extern fn mulberry_file_is_closed(handle: Ptr<UInt8>): Bool;
extern fn mulberry_file_close(handle: Ptr<UInt8>): Bool;
extern fn mulberry_file_seek(file: Ptr<UInt8>, offset: UInt64): Bool;
extern fn mulberry_file_tell(file: Ptr<UInt8>): UInt64;
extern fn mulberry_file_tell_is_valid(position: UInt64): Bool;
extern fn mulberry_file_size(file: Ptr<UInt8>): UInt64;
extern fn mulberry_file_size_is_valid(size: UInt64): Bool;
extern fn mulberry_file_has_error(file: Ptr<UInt8>): Bool;
extern fn mulberry_file_read(file: Ptr<UInt8>, data: Ptr<UInt8>, byteSize: UInt64): UInt64;
extern fn mulberry_file_write(file: Ptr<UInt8>, data: Ptr<UInt8>, byteSize: UInt64): UInt64;
extern fn writeString(value: String): ();
// `imb` enables this hook; batch programs keep `print` without a newline.
extern fn mulberry_repl_print_end(): ();

fn writeText(value: String): () {
  writeString(value);
}

fn print<T: Show>(value: T): () {
  writeText(value.toString());
  mulberry_repl_print_end();
}

fn println<T: Show>(value: T): () {
  writeText(value.toString());
  writeText("\n");
}

fn open(path: String, mode: String): Result<File, FileError> {
  const handle = mulberry_file_open(path, mode);
  if mulberry_file_is_valid(handle) {
    return Ok(File { handle });
  }
  return Err(OpenFailed(path, mode));
}

fn ensureOpen(file: File): Result<(), FileError> {
  if mulberry_file_is_valid(file.handle) {
    if mulberry_file_is_closed(file.handle) {
      return Err(UseAfterClose());
    }
    return Ok(());
  }
  return Err(UseAfterClose());
}

fn close(file: File): Result<(), FileError> {
  if mulberry_file_is_valid(file.handle) {
    if mulberry_file_is_closed(file.handle) {
      return Err(AlreadyClosed());
    }
  } else {
    return Err(AlreadyClosed());
  }
  if mulberry_file_close(file.handle) {
    return Ok(());
  }
  return Err(CloseFailed());
}

fn seek(file: File, offset: UInt64): Result<UInt64, FileError> {
  ensureOpen(file)?;
  if mulberry_file_seek(file.handle, offset) {
    return Ok(offset);
  }
  return Err(SeekFailed(offset));
}

fn tell(file: File): Result<UInt64, FileError> {
  ensureOpen(file)?;
  const position = mulberry_file_tell(file.handle);
  if mulberry_file_tell_is_valid(position) {
    return Ok(position);
  }
  return Err(TellFailed());
}

fn fileSize(file: File): Result<UInt64, FileError> {
  ensureOpen(file)?;
  const size = mulberry_file_size(file.handle);
  if mulberry_file_size_is_valid(size) {
    return Ok(size);
  }
  return Err(SizeFailed());
}

fn read<T: RawBytes>(file: File, mut buffer: Tensor<T>):
    Result<UInt64, FileError> {
  ensureOpen(file)?;
  const expected = buffer.numel * #sizeof(T);
  const actual =
      mulberry_file_read(file.handle, ptr.asUInt8(buffer.data), expected);
  if mulberry_file_has_error(file.handle) {
    return Err(ReadFailed(expected, actual));
  }
  return Ok(actual);
}

fn readExact<T: RawBytes>(file: File, mut buffer: Tensor<T>):
    Result<UInt64, FileError> {
  const expected = buffer.numel * #sizeof(T);
  const actual = read(file, buffer)?;
  if actual != expected {
    return Err(UnexpectedEnd(expected, actual));
  }
  return Ok(actual);
}

fn write<T: RawBytes>(file: File, buffer: Tensor<T>):
    Result<UInt64, FileError> {
  ensureOpen(file)?;
  const expected = buffer.numel * #sizeof(T);
  const actual =
      mulberry_file_write(file.handle, ptr.asUInt8(buffer.data), expected);
  if actual != expected or mulberry_file_has_error(file.handle) {
    return Err(WriteFailed(expected, actual));
  }
  return Ok(actual);
}

fn writeBytes(file: File, bytes: List<UInt8>): Result<UInt64, FileError> {
  ensureOpen(file)?;
  const expected = bytes.length;
  const actual =
      mulberry_file_write(file.handle, ptr.asUInt8(bytes.data), expected);
  if actual != expected or mulberry_file_has_error(file.handle) {
    return Err(WriteFailed(expected, actual));
  }
  return Ok(actual);
}
