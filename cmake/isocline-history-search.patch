+ic_private bool tty_suspend(tty_t* tty) {
+  if (tty == NULL || !tty->raw_enabled) return false;
+  tty_end_raw(tty);
+  signals_restore();
+  // SIGTSTP is restored to its inherited action above. With the usual
+  // default action, raise() stops the process until the shell resumes it.
+  int result = raise(SIGTSTP);
+  if (!tty_init_raw(tty)) return false;
+  if (!tty_start_raw(tty)) return false;
+  return result == 0;
+}
