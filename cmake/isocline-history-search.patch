diff --git a/src/editline_history.c b/src/editline_history.c
--- a/src/editline_history.c
+++ b/src/editline_history.c
@@ -258,3 +258,19 @@ static void edit_history_search_with_current_word(ic_env_t* env, editor_t* eb) {
   edit_history_search( env, eb, initial);
   mem_free(env->mem, initial);
 }
+
+static bool edit_history_has_current_input(ic_env_t* env, editor_t* eb) {
+  const char* input = sbuf_string(eb->input);
+  for (ssize_t index = 0; index < history_count(env->history); ++index) {
+    const char* entry = history_get(env->history, index);
+    if (entry != NULL && strcmp(entry, input) == 0)
+      return true;
+  }
+  return false;
+}
+
+static void edit_history_search_with_current_input(ic_env_t* env, editor_t* eb) {
+  char* initial = sbuf_strdup(eb->input);
+  edit_history_search(env, eb, initial);
+  mem_free(env->mem, initial);
+}
