# RUN: printf 'var x = 40\nx + 2\nx = 41\nx + 1\nstruct Point { x: UInt64, y: UInt64 }\nvar point = Point { 3, 4 }\npoint.x\npoint.x = 9\npoint.x\nfn addOne(value: UInt64): UInt64 { return value + 1; }\naddOne(point.x)\ndata Maybe = None | Some(UInt64);\nfn score(value: Maybe): UInt64 { return match value { Some(score) => score, None() => 0, }; }\nscore(Some(7))\ntrait Twice { fn twice(self): UInt64 { return self + self; } }\nimpl Twice for UInt64 {}\nx.twice()\nimport io; io.println(9)\n:quit\n' | env -u HOME stdbuf -o0 -e0 imb 2>&1 | FileCheck %s

