# RUN: not mulberry-driver -typecheck %s 2>&1 | FileCheck %s

import string;

fn formatWithBudget(comptime pattern: String, value: UInt64): String {
  var index = 0;
  while index < 250000 {
    index = index + 1;
  }
  return string.format(pattern, value);
}

fn main(): UInt64 {
  const text = formatWithBudget("{}", 1);
  return 0;
}

# CHECK: string_format_budget_error.mulberry:14:16: error: comptime evaluation exceeded the step limit
# CHECK-SAME: comptime call stack: formatWithBudget
# CHECK: string_format_budget_error.mulberry:8:13: note: comptime failure was triggered here
