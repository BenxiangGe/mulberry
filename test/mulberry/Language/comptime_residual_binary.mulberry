# RUN: mulberry-driver -typecheck %s
# RUN: mulberry-driver -dump=mlir %s 2>&1 | FileCheck %s --check-prefix=MLIR
# RUN: mulberry-driver %s 2>&1 | FileCheck %s --check-prefix=JIT

fn compose<Args...>(args: Args...): UInt64 {
  const left = args[0] + 1;
  const right = 1 + args[0];
  const pair = args[0] + args[1];
  return left + right + pair;
}

fn main(): UInt64 {
  const result = compose(10, 20, true);
  io.println(result);
  return result;
}

# MLIR-LABEL: func.func @compose__pack_UInt64_UInt64_Bool
# MLIR: arith.addi
# JIT: 52
