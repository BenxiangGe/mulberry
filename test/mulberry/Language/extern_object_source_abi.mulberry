# RUN: mulberry-driver -typecheck %s
# RUN: mulberry-driver -dump=mlir %s 2>&1 | FileCheck %s --check-prefix=MLIR
# RUN: mulberry-driver -dump=lowered-mlir %s 2>&1 | FileCheck %s --check-prefix=LOWERED

extern fn inspectString(value: String): String;
extern fn inspectFile(value: File): File;
extern fn inspectTensor(value: Tensor<Float32>): Tensor<Float32>;

fn stringRoundTrip(value: String): String {
  return inspectString(value);
}

fn fileRoundTrip(value: File): File {
  return inspectFile(value);
}

fn tensorRoundTrip(value: Tensor<Float32>): Tensor<Float32> {
  return inspectTensor(value);
}

fn main(): UInt64 {
  return 0;
}

