# MLIR-SAME: -> !mulberry_core.ptr<!mulberry_core.record<std.string.String
# MLIR-SAME: attributes {mulberry_core.extern_layout_type = (!mulberry_core.record<std.string.String
# MLIR-LABEL: func.func private @inspectFile(!mulberry_core.ptr<!mulberry_core.record<std.io.File
# MLIR-SAME: -> !mulberry_core.ptr<!mulberry_core.record<std.io.File
# MLIR-SAME: attributes {mulberry_core.extern_layout_type = (!mulberry_core.record<std.io.File
# MLIR-LABEL: func.func private @inspectTensor(!mulberry_core.ptr<!mulberry_core.record<std_tensor_Tensor__Float32
# MLIR-SAME: -> !mulberry_core.ptr<!mulberry_core.record<std_tensor_Tensor__Float32
# MLIR-SAME: attributes {mulberry_core.extern_layout_type = (!mulberry_core.record<std_tensor_Tensor__Float32

