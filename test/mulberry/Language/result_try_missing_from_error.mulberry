# RUN: not mulberry-driver -typecheck %s 2>&1 | FileCheck %s

import safetensors;

data LocalError = Failed;

fn forward(result: Result<UInt64, LocalError>):
    Result<UInt64, safetensors.SafetensorsError> {
  return Ok(result?);
}

# CHECK: error: `?` cannot convert error type `LocalError` to `std.safetensors.SafetensorsError`. Add a conversion like:
