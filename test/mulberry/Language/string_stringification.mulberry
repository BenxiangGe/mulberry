# RUN: mulberry-driver -typecheck %s
# RUN: mulberry-driver -dump=ast %s 2>&1 | FileCheck %s --check-prefix=AST
# RUN: mulberry-driver -dump=mlir %s 2>&1 | FileCheck %s --check-prefix=MLIR
# RUN: mulberry-driver %s 2>&1 | FileCheck %s --check-prefix=JIT

import string;

struct Point {
  x: UInt64,
  y: UInt64,

  pub fn toString(self: Point): String {
    return string.format("Point({}, {})", self.x, self.y);
  }
}

struct Plain {
  value: UInt64
}

comptime Box<T> = struct {
  value: T,

  pub fn toString(self: Box<T>): String {
    return string.format("Box({})", self.value);
  }
};

comptime PlainBox<T> = struct {
  value: T
};

fn decorate<T: Show>(value: T): String {
  return string.format("<{}>", value);
}

fn main(): UInt64 {
  const truth = true;
  const byte = core.toUInt8(7);
  const count = 18446744073709551615;
  const loss = 3.5;
  const point = Point { 4, 9 };
  const plain = Plain { 11 };
  const alias = plain;
  const values = [1, 2];
  const box: Box<UInt64> = Box<UInt64> { 12 };
  const plainBox: PlainBox<UInt64> = PlainBox<UInt64> { 13 };

  io.writeText(string.format("scalars {} {} {} {}", truth, byte, count,
                             loss));
  io.writeText("\n");
  io.writeText(string.format("custom {}", point));
  io.writeText("\n");
  io.writeText(string.format("count={}, point={}", count, point));
  io.writeText("\n");
  io.writeText(string.format("plain {}", plain));
  io.writeText("\n");
  io.writeText(string.format("alias {}", alias));
  io.writeText("\n");
  io.writeText(string.format("array {}", values));
  io.writeText("\n");
  io.writeText("generic " + decorate(count) + " " + decorate(point));
  io.writeText("\n");
  io.writeText(string.format("boxes {} {}", box, plainBox));
  io.writeText("\n");
  return 0;
}

# AST-DAG: TraitDecl {{.*}}name=std.string.Show
# AST: Prototype {{.*}}name=decorate parameter=T: Show
# AST-NOT: formatValue

# MLIR: func.func @main
# MLIR-NOT: formatValue

# JIT: scalars true 7 18446744073709551615 3.5
# JIT-NEXT: custom Point(4, 9)
# JIT-NEXT: count=18446744073709551615, point=Point(4, 9)
# JIT-NEXT: plain Plain@0x[[IDENTITY:[0-9a-f]+]]
# JIT-NEXT: alias Plain@0x[[IDENTITY]]
# JIT-NEXT: array [1, 2]
# JIT-NEXT: generic <18446744073709551615> <Point(4, 9)>
# JIT-NEXT: boxes Box(12) PlainBox<UInt64>@0x{{[0-9a-f]+}}
