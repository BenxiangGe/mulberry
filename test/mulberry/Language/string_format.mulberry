# RUN: mulberry-driver -typecheck %s
# RUN: mulberry-driver -dump=ast %s 2>&1 | FileCheck %s --check-prefix=AST
# RUN: mulberry-driver -dump=mlir %s 2>&1 | FileCheck %s --check-prefix=MLIR
# RUN: mulberry-driver %s 2>&1 | FileCheck %s --check-prefix=JIT

import string;

struct Person {
  id: UInt64
}

impl Show for Person {
  fn toString(self: Person): String {
    return "Person";
  }
}

fn main(): UInt64 {
  const name = "Ada";
  const age = 42;
  const enabled = true;
  const person = Person { 7 };
  const message = string.format(
      "name={}, age={}, enabled={}, person={}, braces={{}}", name, age,
      enabled, person);
  const literal = string.format("{{}}");
  io.println(message);
  io.println(literal);
  return age;
}

# JIT: name=Ada, age=42, enabled=true, person=Person, braces={}
# JIT-NEXT: {}

