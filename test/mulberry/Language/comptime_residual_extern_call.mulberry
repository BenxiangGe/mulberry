# RUN: mulberry-driver -typecheck %s
# RUN: mulberry-driver -dump=mlir %s 2>&1 | FileCheck %s

extern fn runtimeValue(): UInt64;

fn residualExternCall<Args...>(args: Args...): UInt64 {
  return runtimeValue() + args[0];
}

fn main(): UInt64 {
  return residualExternCall(20);
}

# CHECK-LABEL: func.func @residualExternCall__pack_UInt64
# CHECK: call @runtimeValue
